{
  "name": "camino",
  "version": "1.0.0",
  "private": true,
  "description": "Camino — naturalization journey coach (iOS app)",
  "scripts": {
    "build:web": "node scripts/build-web.js",
    "build:rc": "esbuild revenuecat-shim.js --bundle --format=iife --outfile=www/revenuecat.js",
    "build": "npm run build:web && npm run build:rc",
    "sync": "npm run build && npx cap sync ios",
    "assets": "npx capacitor-assets generate --ios --iconBackgroundColor '#12b981' --splashBackgroundColor '#12b981'",
    "open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@revenuecat/purchases-capacitor": "^13.7.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.23.0"
  },
  "allowScripts": {
    "esbuild@0.23.1": true,
    "sharp@0.32.6": true
  }
}
